{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.22.3",
      "env": { "APP_ENV": "development" }
    },
    "simulator": { "extends": "development", "ios": { "simulator": true } },
    "preview": {
      "distribution": "internal",
      "node": "22.22.3",
      "env": { "APP_ENV": "preview" }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.22.3",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://saint-augustine-ai-backend.onrender.com"
      }
    }
  },
  "submit": { "production": {} }
}
